#!/usr/bin/env bash
# gpvpn - cliente GlobalProtect para la barra de Omarchy.
#
# Separa el login SAML del tunel: gp-saml-gui corre como el usuario y deja el
# cookie en $XDG_RUNTIME_DIR; openconnect corre como root dentro de la unidad
# systemd gpvpn@<uid>, que una regla polkit deja arrancar y parar sin password.
# Asi conectar y desconectar son acciones independientes y consultables, que es
# lo que un widget necesita.
#
# Un solo tunel a la vez, igual que el cliente oficial.

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gpvpn"
PROFILES="$CONFIG_DIR/profiles.json"

# gp-saml-gui persiste ahi la sesion del proveedor de identidad -las cookies del
# IdP corporativo, no la del tunel- para no tener que reautenticar entera cada
# vez. Por defecto la deja en ~/.gp-saml-gui-cookies con el umask del usuario,
# tipicamente 644. Es material de sesion, no un dotfile mas: va a un directorio
# 700 y con el archivo en 600.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/gpvpn"
COOKIE_JAR="$STATE_DIR/cookies"
LEGACY_COOKIE_JAR="$HOME/.gp-saml-gui-cookies"

UID_SELF="$(id -u)"
UNIT="gpvpn@${UID_SELF}.service"
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/${UID_SELF}}/gpvpn"
PARAMS="$RUNDIR/params"
ACTIVE_FILE="$RUNDIR/active"
AUTH_MARKER="$RUNDIR/authenticating"
ERROR_FILE="$RUNDIR/last-error"

DEFAULT_IFACE="gpvpn0"

# Codigos de salida. El widget los usa para distinguir "el CLI no esta" de "el
# CLI corrio y algo salio mal", que antes colapsaba todo en un mismo mensaje.
EX_FAIL=1        # error generico
EX_USAGE=2       # uso incorrecto
EX_PROGRESS=3    # no es un error: la operacion sigue en curso
EX_NOPROFILES=4  # no hay perfiles configurados
EX_NOBACKEND=5   # falta la unidad systemd o el helper del tunel
EX_BADCONFIG=6   # profiles.json ilegible

die_as() { local code="$1"; shift; printf 'gpvpn: %s\n' "$*" >&2; exit "$code"; }
die() { die_as "$EX_FAIL" "$@"; }

# --- secretos ------------------------------------------------------------

# gp-saml-gui trae --verbose activo por defecto (default=1) y en ese modo
# imprime el cookie SAML a stderr, dentro del comando openconnect que sugiere.
# Ese stderr termina en ERROR_FILE, que a su vez sale por `status --json` hacia
# el panel y las notificaciones. Se le pasa -q, pero el filtro va igual: el
# cookie no puede quedar en disco ni salir por ninguna via de diagnostico.
REDACT_SED=(
  -E
  -e 's/([A-Za-z-]*[Cc]ookie[A-Za-z-]*)=[^[:space:]]+/\1=<redactado>/g'
  -e '/^[[:space:]]*echo /d'
)

redact_secrets() { sed "${REDACT_SED[@]}"; }

redact_error_file() {
  [[ -f $ERROR_FILE ]] || return 0
  sed -i "${REDACT_SED[@]}" "$ERROR_FILE"
}

# 600 explicito en vez de heredar el umask: el archivo puede traer diagnostico
# del login.
new_error_file() { install -m 600 /dev/null "$ERROR_FILE"; }

# Mueve el jar heredado la primera vez y deja los permisos como corresponde.
# Mover en vez de copiar: una copia en 644 en $HOME anularia todo el punto.
ensure_cookie_jar() {
  install -d -m 700 "$STATE_DIR"
  if [[ ! -e $COOKIE_JAR && -f $LEGACY_COOKIE_JAR ]]; then
    if mv "$LEGACY_COOKIE_JAR" "$COOKIE_JAR" 2>/dev/null; then
      echo "gpvpn: sesión del IdP movida a $COOKIE_JAR (modo 600)" >&2
    fi
  fi
  harden_cookie_jar
}

# WebKit reescribe el archivo al cerrar la ventana de login, con el umask del
# proceso: hay que reponer el modo despues, no solo al crearlo.
harden_cookie_jar() {
  if [[ -e $COOKIE_JAR ]]; then
    chmod 600 "$COOKIE_JAR" 2>/dev/null || true
  fi
}

# El cookie es material de sesion y no tiene por que sobrevivir al tunel.
# Antes esto era `shred -u`, que sobre tmpfs no da la sobrescritura que sugiere
# el nombre: tmpfs vive en memoria y no expone un mapeo estable de bloques, asi
# que shred reescribe paginas que el kernel puede haber reubicado. Lo que
# realmente protege es el unlink, el modo 600 y el directorio 700.
wipe_params() { rm -f "$PARAMS"; }

# --- perfiles ------------------------------------------------------------

ensure_profiles() {
  if [[ ! -f $PROFILES ]]; then
    mkdir -p "$CONFIG_DIR"
    printf '{\n  "version": 1,\n  "defaultProfile": null,\n  "profiles": []\n}\n' > "$PROFILES"
  fi
}

profiles_json() { ensure_profiles; cat "$PROFILES"; }

# Un profiles.json corrupto hacia fallar el jq de cmd_status, y el widget leia
# ese fallo generico como "falta el CLI en el PATH": un mensaje directamente
# falso. Se valida antes, con un codigo propio.
validate_profiles() {
  ensure_profiles
  jq -e . "$PROFILES" >/dev/null 2>&1 ||
    die_as "$EX_BADCONFIG" "$PROFILES no es JSON válido"
}

# Reescribe profiles.json aplicandole un programa jq. Recibe los argumentos de
# jq (el filtro y sus --arg) y le agrega el archivo.
#
# El temporal va en el MISMO directorio a proposito: `mktemp` a secas lo crea en
# /tmp, que suele ser tmpfs mientras $HOME esta en otro filesystem, y entre
# filesystems `mv` deja de ser un rename atomico y pasa a ser copiar-y-borrar.
# Un corte a mitad de camino truncaba los perfiles.
edit_profiles() {
  local tmp
  ensure_profiles
  tmp="$(mktemp -p "$CONFIG_DIR" .profiles.XXXXXX)" ||
    die "no se pudo crear un temporal en $CONFIG_DIR"
  chmod 600 "$tmp"
  # Si jq falla, o deja el archivo vacio, los perfiles quedan como estaban.
  if ! jq "$@" "$PROFILES" > "$tmp" || [[ ! -s $tmp ]]; then
    rm -f "$tmp"
    die "no se pudo actualizar $PROFILES"
  fi
  mv "$tmp" "$PROFILES"
}

profile_get() {
  profiles_json | jq -e --arg id "$1" '.profiles[] | select(.id == $id)'
}

profile_ids() { profiles_json | jq -r '.profiles[].id'; }

default_profile_id() {
  local id
  id="$(profiles_json | jq -r '.defaultProfile // empty')"
  if [[ -n $id ]]; then
    printf '%s' "$id"
    return
  fi
  # Sin default explicito manda el primero: con un solo perfil declarado, pedir
  # el id en cada comando seria puro ruido.
  profiles_json | jq -r '.profiles[0].id // empty'
}

resolve_profile() {
  local id="${1-}"
  if [[ -z $id ]]; then
    id="$(default_profile_id)"
    [[ -n $id ]] ||
      die_as "$EX_NOPROFILES" "no hay perfiles; crea uno con: gpvpn profile add --help"
  fi
  profile_get "$id" >/dev/null 2>&1 || die "no existe el perfil '$id'"
  printf '%s' "$id"
}

profile_field() {
  profile_get "$1" | jq -r --arg f "$2" '.[$f] // empty'
}

profile_name() {
  local n
  n="$(profile_field "$1" name)"
  printf '%s' "${n:-$1}"
}

profile_iface() {
  local i
  i="$(profile_field "$1" interface)"
  printf '%s' "${i:-$DEFAULT_IFACE}"
}

# --- runtime, lock y marker ----------------------------------------------

ensure_rundir() { install -d -m 700 "$RUNDIR"; }

# El tunel corre como root y deriva la ruta del params del uid, no de una
# variable de entorno del usuario: aceptar una ruta del llamador seria darle a
# root un puntero arbitrario. La contra es que las dos rutas tienen que
# coincidir, y si no coinciden es mejor decirlo aca -nombrando las dos- que
# dejar que el tunel muera con un "no hay parametros" que apunta a otro lado.
# Solo se exige al conectar: status, list y profile no tocan el params.
check_rundir() {
  local expected="/run/user/${UID_SELF}/gpvpn"
  [[ $RUNDIR == "$expected" ]] && return 0
  die "el params se escribiría en $RUNDIR pero el túnel lo lee de $expected; revisa XDG_RUNTIME_DIR"
}

# Serializa connect/disconnect. El widget y una terminal pueden pedir cosas a la
# vez, y dos connect en paralelo se pisan el params, el marker y el archivo de
# perfil activo. `status` NO toma el lock a proposito: el widget lo pollea cada
# pocos segundos y no puede quedarse esperando.
lock_or_die() {
  ensure_rundir
  exec 9>"$RUNDIR/lock"
  flock -n 9 || die "ya hay otra operación de gpvpn en curso"
}

# El marker guarda el PID del login en curso. El trap cubre la salida normal y
# las senales, pero no un SIGKILL ni un cierre de sesion: sin esta comprobacion
# un marker huerfano dejaba a state() devolviendo `authenticating` para siempre
# -widget latiendo, connect negandose- sin forma de recuperarse desde la UI.
auth_in_progress() {
  [[ -f $AUTH_MARKER ]] || return 1
  local pid
  pid="$(cat "$AUTH_MARKER" 2>/dev/null || true)"
  if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  rm -f "$AUTH_MARKER"
  return 1
}

# --- estado --------------------------------------------------------------

unit_state() { systemctl is-active "$UNIT" 2>/dev/null || true; }

active_profile_id() {
  if [[ -f $ACTIVE_FILE ]]; then cat "$ACTIVE_FILE"; fi
}

# Devuelve vacio cuando la interfaz todavia no existe; con pipefail el fallo de
# `ip` tumbaria el script entero.
iface_ip() {
  local out
  out="$(ip -4 -o addr show "$1" 2>/dev/null || true)"
  if [[ -z $out ]]; then
    return 0
  fi
  # Un solo awk y sin pipeline a proposito: con `head` cerrando temprano, el
  # SIGPIPE rio arriba mas `pipefail` hacen que esta funcion retorne != 0, y
  # como su salida se consume en asignaciones (ip="$(iface_ip ...)"), `set -e`
  # tumbaba el script entero de forma intermitente.
  awk 'NR == 1 { split($4, a, "/"); print a[1] }' <<<"$out"
}

current_iface() {
  local id
  id="$(active_profile_id)"
  if [[ -n $id ]] && profile_get "$id" >/dev/null 2>&1; then
    profile_iface "$id"
  else
    printf '%s' "$DEFAULT_IFACE"
  fi
}

# La unidad se pone activa apenas arranca openconnect, que todavia tarda en
# negociar: el estado real lo define la interfaz.
state() {
  if auth_in_progress; then
    echo authenticating
    return
  fi
  case "$(unit_state)" in
    active | activating | reloading)
      if [[ -n "$(iface_ip "$(current_iface)")" ]]; then echo connected; else echo connecting; fi ;;
    failed) echo failed ;;
    *) echo disconnected ;;
  esac
}

since_iso() {
  local ts
  ts="$(systemctl show -P ActiveEnterTimestamp "$UNIT" 2>/dev/null || true)"
  if [[ -z $ts || $ts == "n/a" ]]; then
    return
  fi
  date -d "$ts" -Iseconds 2>/dev/null || true
}

# Un openconnect ajeno (otro cliente GP corriendo aparte) se pelearia con este por
# la tabla de rutas.
foreign_openconnect() {
  local ours pid
  ours="$(systemctl show -P MainPID "$UNIT" 2>/dev/null || echo 0)"
  while read -r pid; do
    [[ -z $pid || $pid == "$ours" ]] && continue
    printf '%s' "$pid"
    return 0
  done < <(pgrep -x openconnect 2>/dev/null || true)
  return 1
}

cmd_status() {
  validate_profiles
  local st iface ip since err id name
  st="$(state)"
  iface="$(current_iface)"
  ip="$(iface_ip "$iface")"
  since="$(since_iso)"
  id="$(active_profile_id)"
  name=""
  if [[ -n $id ]] && profile_get "$id" >/dev/null 2>&1; then
    name="$(profile_name "$id")"
  fi
  err=""
  if [[ $st == failed || $st == disconnected ]] && [[ -f $ERROR_FILE ]]; then
    err="$(tail -c 400 "$ERROR_FILE" | redact_secrets)"
  fi

  if [[ ${1-} == --json ]]; then
    jq -n \
      --arg state "$st" --arg profile "$id" --arg profileName "$name" \
      --arg interface "$iface" --arg ip "$ip" --arg since "$since" \
      --arg unit "$UNIT" --arg error "$err" \
      --argjson profiles "$(profiles_json | jq '[.profiles[] | {id, name, server, mode, gateway, clientos, interface}]')" \
      --arg defaultProfile "$(default_profile_id)" \
      '{state: $state, profile: $profile, profileName: $profileName,
        interface: $interface, ip: $ip, since: $since, unit: $unit,
        error: $error, defaultProfile: $defaultProfile, profiles: $profiles}'
  else
    printf 'estado    : %s\nperfil    : %s\ninterfaz  : %s\nip        : %s\ndesde     : %s\n' \
      "$st" "${name:--}" "$iface" "${ip:--}" "${since:--}"
    if [[ -n $err ]]; then
      printf 'error     : %s\n' "$err"
    fi
  fi
}

cmd_list() {
  local def cur live rows id name server mode mark
  def="$(default_profile_id)"
  cur="$(active_profile_id)"

  # state() consulta systemctl y la interfaz: se resuelve una vez, no una por
  # fila. Antes cada perfil costaba ademas tres jq y tres cat para leer tres
  # campos del mismo archivo.
  live=""
  if [[ -n $cur ]] && [[ "$(state)" == connected ]]; then
    live="$cur"
  fi

  rows="$(profiles_json | jq -r '
    .profiles[] | [.id, (.name // "-"), (.server // "-"), (.mode // "gateway")] | @tsv')"
  if [[ -z $rows ]]; then
    echo "No hay perfiles. Crea uno con: gpvpn profile add --help"
    return
  fi

  printf '%-3s %-14s %-24s %-32s %s\n' "" "ID" "NOMBRE" "SERVIDOR" "MODO"
  while IFS=$'\t' read -r id name server mode; do
    mark=" "
    [[ $id == "$def" ]] && mark="*"
    [[ $id == "$live" ]] && mark="●"
    printf '%-3s %-14s %-24s %-32s %s\n' "$mark" "$id" "$name" "$server" "$mode"
  done <<<"$rows"
}

# gp-saml-gui manda su PROPIO clientos en el prelogin al portal, y usa otro
# vocabulario que el --os de openconnect: Linux/Mac/Windows contra
# linux-64/mac-intel/win. Son dos cosas distintas en dos momentos distintos, y
# el portal mira la primera: es ahi donde rechaza a los clientes Linux. Sin este
# mapeo, poner clientos=win en el perfil solo cambiaba lo que se reporta DESPUES
# de autenticar, o sea justo donde ya no importa.
#
# android y apple-ios no tienen equivalente en gp-saml-gui (solo admite esos
# tres): para ellos el prelogin sigue con el default y solo cambia el tunel.
saml_clientos() {
  case "$1" in
    linux | linux-64) printf 'Linux' ;;
    win)              printf 'Windows' ;;
    mac-intel)        printf 'Mac' ;;
    *)                printf '' ;;
  esac
}

# --- conectar ------------------------------------------------------------

cmd_connect() {
  local id
  id="$(resolve_profile "${1-}")"

  # El lock va antes de mirar el estado: entre el chequeo y la accion habia una
  # ventana en la que otro proceso podia cambiar todo bajo los pies.
  lock_or_die

  case "$(state)" in
    authenticating) die "ya hay un login SAML en curso" ;;
    connected | connecting)
      if [[ "$(active_profile_id)" == "$id" ]]; then
        echo "Ya conectado a $(profile_name "$id")." >&2
        return 0
      fi
      # Cambiar de perfil es bajar y volver a subir: un solo tunel a la vez.
      echo "Cambiando de $(profile_name "$(active_profile_id)") a $(profile_name "$id")…" >&2
      cmd_disconnect >/dev/null ;;
  esac

  local pid
  if pid="$(foreign_openconnect)"; then
    die "ya hay otro openconnect corriendo (pid $pid); baja esa VPN primero"
  fi

  command -v gp-saml-gui >/dev/null || die_as "$EX_NOBACKEND" "falta gp-saml-gui"
  systemctl cat gpvpn@.service >/dev/null 2>&1 ||
    die_as "$EX_NOBACKEND" "falta la unidad systemd gpvpn@.service; corre: gpvpn setup"

  local server mode gateway clientos iface
  server="$(profile_field "$id" server)"
  mode="$(profile_field "$id" mode)"
  gateway="$(profile_field "$id" gateway)"
  clientos="$(profile_field "$id" clientos)"
  iface="$(profile_iface "$id")"
  [[ -n $server ]] || die "el perfil '$id' no tiene servidor"

  check_rundir
  ensure_rundir
  ensure_cookie_jar
  new_error_file
  printf '%s\n' "$$" > "$AUTH_MARKER"
  # El marker no puede sobrevivir a un login abortado o el widget queda colgado.
  # Las senales van explicitas: con solo EXIT, un Ctrl-C lo dejaba atras.
  trap 'rm -f "$AUTH_MARKER"' EXIT INT TERM HUP

  # -g autentica contra el gateway, -p contra el portal (el default de
  # gp-saml-gui). Sin flag de exec imprime HOST/USER/COOKIE/OS en stdout en vez
  # de lanzar openconnect el mismo, que es lo que permite separar las dos fases.
  local saml_args=(-g)
  [[ $mode == portal ]] && saml_args=(-p)
  local saml_os
  saml_os="$(saml_clientos "${clientos:-linux-64}")"
  if [[ -n $saml_os ]]; then
    saml_args+=(--clientos "$saml_os")
  fi

  local saml
  # WEBKIT_DISABLE_COMPOSITING_MODE y GDK_BACKEND=x11 evitan que la ventana de
  # login salga en negro bajo Wayland.
  # -q apaga el bloque verboso de gp-saml-gui, que es el que imprime el cookie.
  # Los errores accionables ("Login window closed by user.", los tracebacks) no
  # dependen de la verbosidad y siguen llegando.
  if ! saml="$(WEBKIT_DISABLE_COMPOSITING_MODE=1 GDK_BACKEND=x11 \
                 gp-saml-gui -q --cookies "$COOKIE_JAR" \
                   "${saml_args[@]}" "$server" 2>"$ERROR_FILE")"; then
    harden_cookie_jar
    redact_error_file
    die "el login SAML falló: $(tail -c 300 "$ERROR_FILE" | redact_secrets)"
  fi
  harden_cookie_jar
  redact_error_file

  local HOST USER COOKIE OS
  # gp-saml-gui pasa los cuatro valores por shlex.quote, asi que el eval es
  # seguro mientras la salida sea exactamente esas cuatro asignaciones. En vez
  # de escribir un parser de shlex a mano -que tendria mas chances de meter un
  # bug que de arreglar uno- se valida la forma y recien despues se evalua.
  #
  # shlex.quote emite el valor de una de dos formas: una corrida de caracteres
  # seguros (%+,-./0-9:=@A-Z_a-z, tal cual figura en su fuente), o el valor
  # entero entre comillas simples. Cualquier otra cosa -un `;`, un `&&`, una
  # linea de mas, o el escape '"'"' que shlex usa para un apostrofo interno-
  # no matchea y aborta sin evaluar nada.
  # En bash puro y no con `grep -qv`: la semantica de -q junto a -v difiere
  # entre implementaciones de grep, y de esto depende que se evalue o no.
  local saml_re="^(HOST|USER|COOKIE|OS)=([A-Za-z0-9_%+,./:=@-]*|'[^']*')$"
  local line
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    [[ $line =~ $saml_re ]] ||
      die "gp-saml-gui devolvió una salida con una forma inesperada; no se evalúa"
  done <<<"$saml"
  eval "$saml"
  [[ -n ${HOST-} && -n ${COOKIE-} ]] || die "gp-saml-gui no devolvió un cookie"

  (
    umask 077
    {
      printf 'HOST=%s\n' "$HOST"
      printf 'VPN_USER=%s\n' "${USER-}"
      printf 'COOKIE=%s\n' "$COOKIE"
      printf 'CLIENTOS=%s\n' "${clientos:-${OS-linux-64}}"
      printf 'IFACE=%s\n' "$iface"
      # --authgroup elige el gateway cuando se autentico contra un portal; es
      # el mismo campo que el desplegable del cliente oficial.
      [[ -n $gateway ]] && printf 'AUTHGROUP=%s\n' "$gateway"
      profile_get "$id" | jq -r '(.extraArgs // [])[]' | while read -r a; do
        [[ -n $a ]] && printf 'EXTRA=%s\n' "$a"
      done
    } > "$PARAMS"
  )

  printf '%s' "$id" > "$ACTIVE_FILE"
  rm -f "$AUTH_MARKER"
  trap - EXIT

  if ! systemctl start "$UNIT" 2>"$ERROR_FILE"; then
    rm -f "$ACTIVE_FILE"
    # El tunel no llego a leerlo: el cookie no puede quedar en tmpfs.
    wipe_params
    die "no se pudo arrancar $UNIT: $(tail -c 300 "$ERROR_FILE" | redact_secrets)"
  fi

  # Espera a que la interfaz tenga IP para no reportar exito antes de tiempo.
  local i
  for ((i = 0; i < 120; i++)); do
    if [[ -n "$(iface_ip "$iface")" ]]; then
      echo "Conectado a $(profile_name "$id") ($iface $(iface_ip "$iface"))"
      return 0
    fi
    # La unidad murio: eso si es un fallo, y se reporta como tal enseguida.
    if [[ "$(unit_state)" == failed ]]; then
      dump_unit_log
      die "el túnel falló al levantar; revisa: gpvpn logs"
    fi
    sleep 0.5
  done

  # Se agoto la espera pero la unidad sigue viva: es una negociacion lenta, no
  # un fallo. Antes se moria con error dejando el tunel corriendo, asi que el
  # widget disparaba una notificacion roja por una conexion que despues
  # levantaba sola. Se sale con EX_PROGRESS y no se baja nada.
  dump_unit_log
  die_as "$EX_PROGRESS" "el túnel sigue negociando; mira: gpvpn status"
}

dump_unit_log() {
  journalctl -u "$UNIT" -n 20 --no-pager -o cat > "$ERROR_FILE" 2>/dev/null || true
  redact_error_file
}

# --- desconectar ---------------------------------------------------------

cmd_disconnect() {
  lock_or_die
  rm -f "$AUTH_MARKER"
  systemctl stop "$UNIT" || die "no se pudo parar $UNIT"
  # `stop` no limpia el estado `failed`: sin esto, tras un arranque fallido el
  # widget se queda en rojo para siempre aunque ya no haya nada corriendo.
  systemctl reset-failed "$UNIT" 2>/dev/null || true
  rm -f "$ACTIVE_FILE"
  wipe_params
  # El diagnostico del login tampoco tiene por que sobrevivir a la sesion.
  rm -f "$ERROR_FILE"
  echo "Desconectado."
}

cmd_toggle() {
  case "$(state)" in
    connected | connecting | authenticating) cmd_disconnect ;;
    *) cmd_connect "${1-}" ;;
  esac
}

cmd_logs() {
  if [[ $# -eq 0 ]]; then
    journalctl -u "$UNIT" --no-pager -n 50
  else
    journalctl -u "$UNIT" "$@"
  fi
}

# --- perfiles (escritura) ------------------------------------------------

# Compartidos entre add y edit, para que las dos rutas validen igual.
valid_mode() {
  case "$1" in gateway | portal) ;; *) die_as "$EX_USAGE" "--mode debe ser gateway o portal" ;; esac
}
valid_clientos() {
  case "$1" in
    linux | linux-64 | win | mac-intel | android | apple-ios) ;;
    *) die_as "$EX_USAGE" "--clientos inválido: $1" ;;
  esac
}
valid_iface() {
  [[ $1 =~ ^[a-zA-Z0-9_-]{1,15}$ ]] || die_as "$EX_USAGE" "nombre de interfaz inválido"
}

profile_usage() {
  cat <<'USAGE'
uso: gpvpn profile <acción>

  add --id ID --server HOST [opciones]   Crea o reemplaza un perfil
  edit --id ID [opciones]                 Cambia solo los campos que le pases
  rm ID                                   Borra un perfil
  default ID                              Marca el perfil por defecto
  list                                    Igual que `gpvpn list`

opciones de add y edit:
  --name NOMBRE        Etiqueta visible (default: el id)
  --mode gateway|portal  Contra qué autentica gp-saml-gui (default: gateway)
  --gateway NOMBRE     Gateway a elegir cuando el modo es portal (--authgroup)
  --user USUARIO       Usuario a pasarle a openconnect (normalmente lo da el SAML)
  --clientos VALOR     SO que se le reporta al portal y al gateway. No describe
                       tu maquina: sirve para pasar portales que rechazan Linux.
                       linux-64 (default), linux, win, mac-intel, android, apple-ios
  --interface NOMBRE   Interfaz del túnel (default: gpvpn0)
USAGE
}

cmd_profile_add() {
  local id="" name="" server="" mode="gateway" gateway="" user="" clientos="linux-64" iface="$DEFAULT_IFACE"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --id) id="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --server) server="$2"; shift 2 ;;
      --mode) mode="$2"; shift 2 ;;
      --gateway) gateway="$2"; shift 2 ;;
      --user) user="$2"; shift 2 ;;
      --clientos) clientos="$2"; shift 2 ;;
      --interface) iface="$2"; shift 2 ;;
      -h | --help) profile_usage; return 0 ;;
      *) die_as "$EX_USAGE" "opción desconocida: $1" ;;
    esac
  done

  [[ -n $id ]] || die_as "$EX_USAGE" "falta --id"
  [[ -n $server ]] || die_as "$EX_USAGE" "falta --server"
  [[ $id =~ ^[a-zA-Z0-9_-]+$ ]] || die "el id solo admite letras, números, guion y guion bajo"
  valid_mode "$mode"
  valid_clientos "$clientos"
  valid_iface "$iface"

  edit_profiles \
     --arg id "$id" --arg name "${name:-$id}" --arg server "$server" \
     --arg mode "$mode" --arg gateway "$gateway" --arg user "$user" \
     --arg clientos "$clientos" --arg iface "$iface" \
     '
     def entry: {
       id: $id, name: $name, server: $server, mode: $mode,
       gateway: (if $gateway == "" then null else $gateway end),
       user: (if $user == "" then null else $user end),
       clientos: $clientos, interface: $iface, extraArgs: []
     };
     .profiles = ((.profiles // []) | map(select(.id != $id)) + [entry])
     | .defaultProfile = (.defaultProfile // $id)
     '
  echo "Perfil '$id' guardado."
}

# add reemplaza el perfil entero; edit toca SOLO los campos que se le pasan.
# Esa es la razon por la que el formulario del panel podia dar de alta pero no
# editar: sin un merge no habia forma de cambiar un campo sin reescribir el
# resto, y el formulario no pide todos.
cmd_profile_edit() {
  local id=""
  local -a jqargs=() sets=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --id)     id="$2"; shift 2 ;;
      --name)   jqargs+=(--arg name "$2");   sets+=('.name = $name');     shift 2 ;;
      --server) jqargs+=(--arg server "$2"); sets+=('.server = $server'); shift 2 ;;
      --mode)   valid_mode "$2"; jqargs+=(--arg mode "$2"); sets+=('.mode = $mode'); shift 2 ;;
      --gateway)
        jqargs+=(--arg gateway "$2")
        sets+=('.gateway = (if $gateway == "" then null else $gateway end)'); shift 2 ;;
      --user)
        jqargs+=(--arg user "$2")
        sets+=('.user = (if $user == "" then null else $user end)'); shift 2 ;;
      --clientos)
        valid_clientos "$2"; jqargs+=(--arg clientos "$2")
        sets+=('.clientos = $clientos'); shift 2 ;;
      --interface)
        valid_iface "$2"; jqargs+=(--arg iface "$2")
        sets+=('.interface = $iface'); shift 2 ;;
      -h | --help) profile_usage; return 0 ;;
      *) die_as "$EX_USAGE" "opción desconocida: $1" ;;
    esac
  done

  [[ -n $id ]] || die_as "$EX_USAGE" "falta --id"
  profile_get "$id" >/dev/null 2>&1 || die "no existe el perfil '$id'"
  [[ ${#sets[@]} -gt 0 ]] || die_as "$EX_USAGE" "no hay ningún campo que cambiar"

  local body
  body="$(printf '%s | ' "${sets[@]}")"
  body="${body% | }"
  edit_profiles --arg id "$id" "${jqargs[@]}" \
    ".profiles = (.profiles | map(if .id == \$id then ($body) else . end))"
  echo "Perfil '$id' actualizado."
}

cmd_profile_rm() {
  local id="${1-}"
  [[ -n $id ]] || die_as "$EX_USAGE" "falta el id"
  ensure_profiles
  profile_get "$id" >/dev/null 2>&1 || die "no existe el perfil '$id'"
  edit_profiles --arg id "$id" '
    .profiles = ((.profiles // []) | map(select(.id != $id)))
    | .defaultProfile = (if .defaultProfile == $id then (.profiles[0].id // null) else .defaultProfile end)
    '
  echo "Perfil '$id' borrado."
}

cmd_profile_default() {
  local id
  id="$(resolve_profile "${1-}")"
  edit_profiles --arg id "$id" '.defaultProfile = $id'
  echo "Perfil por defecto: $id"
}

cmd_profile() {
  case "${1-}" in
    add) shift; cmd_profile_add "$@" ;;
    edit) shift; cmd_profile_edit "$@" ;;
    rm | remove) shift; cmd_profile_rm "$@" ;;
    default) shift; cmd_profile_default "$@" ;;
    list | "") cmd_list ;;
    -h | --help) profile_usage ;;
    *) profile_usage; exit "$EX_USAGE" ;;
  esac
}

# --- setup ---------------------------------------------------------------

# Para la instalacion por git (omarchy plugin add), que solo copia el QML: la
# unidad y la regla polkit hay que ponerlas igual.
cmd_setup() {
  local here unit rules
  if [[ ${1-} != --force ]] &&
     systemctl cat gpvpn@.service >/dev/null 2>&1 &&
     [[ -x /usr/lib/gpvpn/gpvpn-tunnel ]]; then
    echo "El backend ya está instalado (usa --force para reinstalarlo)."
    return 0
  fi
  here="$(dirname "$(dirname "$(readlink -f "$0")")")"
  unit="$here/systemd/gpvpn@.service"
  rules="$here/polkit/48-gpvpn.rules"
  [[ -f $unit && -f $rules ]] || die "no encuentro los archivos de sistema junto a $0"

  pkexec bash -c '
    set -e
    install -Dm755 "$1" /usr/lib/gpvpn/gpvpn-tunnel
    install -Dm644 "$2" /usr/lib/systemd/system/gpvpn@.service
    install -Dm644 "$3" /usr/share/polkit-1/rules.d/48-gpvpn.rules
    systemctl daemon-reload
  ' _ "$here/libexec/gpvpn-tunnel" "$unit" "$rules"
  echo "Backend instalado."
}

usage() {
  cat <<'USAGE'
uso: gpvpn <comando>

  connect [perfil]     Login SAML y levanta el túnel
  disconnect           Baja el túnel y borra el cookie
  toggle [perfil]      Conecta o desconecta según el estado
  status [--json]      Estado actual (--json es lo que consume el widget)
  list                 Perfiles configurados
  profile <acción>     add / rm / default (ver: gpvpn profile --help)
  logs [args]          Journal de la unidad del túnel
  setup                Instala unidad systemd y regla polkit (pide root)

Perfiles en ~/.config/gpvpn/profiles.json

Códigos de salida:
  0  ok                     3  en curso (el túnel sigue negociando)
  1  error                  4  no hay perfiles configurados
  2  uso incorrecto         5  falta el backend (gpvpn setup)
                            6  profiles.json ilegible
USAGE
}

case "${1-}" in
  connect) shift; cmd_connect "${1-}" ;;
  disconnect | down) cmd_disconnect ;;
  toggle) shift; cmd_toggle "${1-}" ;;
  status) shift; cmd_status "$@" ;;
  list | ls) cmd_list ;;
  profile) shift; cmd_profile "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  setup) shift; cmd_setup "${1-}" ;;
  -h | --help | help | "") usage ;;
  *) usage; exit "$EX_USAGE" ;;
esac
