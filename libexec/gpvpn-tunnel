#!/usr/bin/env bash
# Arranca openconnect como root con el cookie SAML que dejo el usuario.
# Lo invoca gpvpn@<uid>.service; no esta pensado para uso directo.

set -euo pipefail

uid="${1-}"
[[ $uid =~ ^[0-9]+$ ]] || { echo "uid invalido" >&2; exit 64; }

params="/run/user/${uid}/gpvpn/params"
[[ -f $params ]] || { echo "no hay parametros en $params" >&2; exit 78; }

# El archivo trae un cookie de sesion y lo leemos con privilegios de root: si no
# es del uid que pidio la conexion, o es legible por terceros, no va.
owner="$(stat -c %u "$params")"
mode="$(stat -c %a "$params")"
[[ $owner == "$uid" ]] || { echo "$params no pertenece al uid $uid" >&2; exit 77; }
[[ $mode == 600 ]] || { echo "$params tiene permisos $mode, se esperaba 600" >&2; exit 77; }

# Los EXTRA salen de `extraArgs` en el profiles.json, o de quien haya escrito el
# params: entrada sin privilegios que termina en el argv de un proceso root.
# openconnect tiene opciones que ejecutan comandos (--script, --csd-wrapper),
# que leen mas opciones desde un archivo (--config, --xmlconfig, por donde se
# colaria cualquier otra), que escriben archivos (--pid-file) y que vuelcan el
# cookie al journal (--dump-http-traffic, --printcookie).
#
# Se comparan por PREFIJO porque getopt_long acepta abreviaturas no ambiguas:
# contra openconnect v9.21, `--csd-wrap=X` resuelve a --csd-wrapper y `--conf=X`
# a --config, asi que una lista de nombres literales se evade con un caracter.
FORBIDDEN_EXTRA=(
  script script-tun csd-wrapper csd-user          # ejecutan comandos como root
  config xmlconfig                                # evadirian esta misma lista
  pid-file                                        # escritura arbitraria como root
  cookie cookie-on-stdin cookieonly printcookie   # exponen el cookie
  dump-http-traffic                               # implica --verbose: cookie al journal
  interface os                                    # eluden la validacion de aca abajo
  background                                      # rompe Type=exec
)

# Las opciones cortas se rechazan enteras: getopt acepta el valor pegado
# (-s/tmp/x) y el agrupamiento (-qs /tmp/x), asi que no hay forma confiable de
# filtrarlas por patron. La forma larga es la unica admitida.
check_extra() {
  local arg="$1" name f
  case "$arg" in
    --*) name="${arg#--}"; name="${name%%=*}" ;;
    -?*) echo "argumento extra en forma corta, usa la forma larga: $arg" >&2; exit 64 ;;
    *) return 0 ;;   # valor suelto de una opcion anterior
  esac
  [[ -n $name ]] || return 0
  for f in "${FORBIDDEN_EXTRA[@]}"; do
    if [[ $f == "$name"* ]]; then
      echo "argumento extra prohibido: $arg (resuelve a --$f)" >&2
      exit 64
    fi
  done
}

# Parser propio en vez de `source`: el archivo lo escribe un proceso sin
# privilegios y no queremos ejecutar nada de lo que venga adentro.
declare -A p=()
extra=()
while IFS='=' read -r key value; do
  case "$key" in
    "") ;;
    EXTRA) check_extra "$value"; extra+=("$value") ;;
    *) p[$key]="$value" ;;
  esac
done < "$params"

host="${p[HOST]-}"
cookie="${p[COOKIE]-}"
user="${p[VPN_USER]-}"
clientos="${p[CLIENTOS]-linux-64}"
iface="${p[IFACE]-gpvpn0}"
authgroup="${p[AUTHGROUP]-}"

[[ -n $host && -n $cookie ]] || { echo "faltan HOST o COOKIE" >&2; exit 78; }
# HOST es el unico valor del params que llega al argv como elemento suelto (el
# resto va como --opcion=valor, que no puede partirse). Y getopt permuta: un
# HOST con forma de opcion se parsea como opcion y evade el filtro de EXTRA.
#
# Lo unico que hace falta garantizar es que no pueda empezar con guion, y de eso
# ya se encarga exigir el esquema https://. El path va libre a proposito: es
# `<interface>:<nombre-de-cookie>` (gp-saml-gui lo arma como
# `gateway:prelogin-cookie` o `portal:portal-userauthcookie`), y acotarlo por
# caracteres solo sirve para rechazar hosts legitimos.
[[ $host =~ ^https://[A-Za-z0-9._-]+(:[0-9]{1,5})?(/[^[:space:]]*)?$ ]] ||
  { echo "HOST invalido: $host" >&2; exit 64; }
[[ $iface =~ ^[a-zA-Z0-9_-]{1,15}$ ]] || { echo "interfaz invalida" >&2; exit 64; }

# gp-saml-gui emite el valor en el vocabulario de openconnect (linux-64, win,
# mac-intel...), no el de --clientos (Linux/Windows/Mac).
case "$clientos" in
  linux | linux-64 | win | mac-intel | android | apple-ios) ;;
  *) echo "clientos invalido para openconnect: $clientos" >&2; exit 64 ;;
esac

args=(
  --protocol=gp
  --os="$clientos"
  --interface="$iface"
  --script=/etc/vpnc/vpnc-script
  --passwd-on-stdin
)
if [[ -n $user ]]; then
  args+=(--user="$user")
fi
# --authgroup es el campo que en GlobalProtect elige el gateway dentro de un
# portal: el mismo desplegable del cliente oficial.
if [[ -n $authgroup ]]; then
  args+=(--authgroup="$authgroup")
fi
if [[ ${#extra[@]} -gt 0 ]]; then
  args+=("${extra[@]}")
fi

# exec para que openconnect sea el proceso principal de la unidad: asi systemd
# le manda SIGINT directo al parar y el tunel baja limpio.
exec openconnect "${args[@]}" "$host" <<<"$cookie"
