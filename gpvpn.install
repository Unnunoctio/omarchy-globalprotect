post_install() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
  update-desktop-database -q usr/share/applications >/dev/null 2>&1 || true

  cat <<'MSG'
:: gpvpn instalado. Falta crear al menos un perfil:
     gpvpn profile add --id trabajo --name "Trabajo" --server vpn.empresa.com
   Y el widget de la barra:
     ./install.sh --plugin
     omarchy plugin enable unnunoctio.globalprotect right
MSG
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
  update-desktop-database -q usr/share/applications >/dev/null 2>&1 || true
}

pre_remove() {
  systemctl stop 'gpvpn@*.service' >/dev/null 2>&1 || true
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
  update-desktop-database -q usr/share/applications >/dev/null 2>&1 || true
}
