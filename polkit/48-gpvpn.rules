// Deja que un usuario local y activo arranque y pare SU PROPIO tunel sin
// password. El alcance esta acotado a las unidades gpvpn@<uid>: todo lo demas
// de systemd sigue pidiendo autenticacion.
//
// La comparacion de uid es lo que ata la unidad al que llama. Sin ella, el
// patron gpvpn@<uid> solo validaba la forma del nombre, y cualquiera que pasara
// el resto de los filtros podia parar el tunel de otro usuario o arrancar uno
// que lee el cookie ajeno.
polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units") {
    return polkit.Result.NOT_HANDLED;
  }

  var unit = action.lookup("unit");
  if (!unit) {
    return polkit.Result.NOT_HANDLED;
  }

  var match = /^gpvpn@([0-9]+)\.service$/.exec(unit);
  if (!match) {
    return polkit.Result.NOT_HANDLED;
  }

  // reset-failed va en la lista porque `stop` no limpia el estado `failed`, y
  // sin limpiarlo el widget queda en rojo tras cualquier arranque fallido. No
  // arranca ni para nada: solo descarta el resultado del ultimo intento.
  var verb = action.lookup("verb");
  if (verb !== "start" && verb !== "stop" && verb !== "restart" &&
      verb !== "reset-failed") {
    return polkit.Result.NOT_HANDLED;
  }

  // Como string, no como numero: asi tambien caen las formas no canonicas
  // (gpvpn@01000.service para el uid 1000), que fallarian mas adelante de todos
  // modos pero no tienen por que llegar hasta ahi.
  if (String(subject.uid) !== match[1]) {
    return polkit.Result.NOT_HANDLED;
  }

  // El tunel reescribe rutas y DNS de toda la maquina, no solo del usuario, por
  // eso sigue exigiendo wheel ademas del uid propio. Si alguna vez hace falta
  // que un usuario comun levante el suyo, esta es la linea a relajar.
  if (subject.local && subject.active && subject.isInGroup("wheel")) {
    return polkit.Result.YES;
  }

  return polkit.Result.NOT_HANDLED;
});
